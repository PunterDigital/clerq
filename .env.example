# Postgres connection for the app and drizzle-kit migrate/push.
# The docker-compose setup provides this automatically; for local dev
# against your own Postgres, copy this file to .env and adjust.
DATABASE_URL=postgresql://clerq:clerq@localhost:5432/clerq

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# The URL your instance is reached on (used for auth callbacks/redirects).
BETTER_AUTH_URL=http://localhost:3000

# docker compose only: the app is published on 127.0.0.1:3000 by default, so
# only this machine (or a reverse proxy on it) can reach it. Set APP_BIND to
# 0.0.0.0 to serve other machines directly, and APP_PORT to change the port.
# APP_BIND=127.0.0.1
# APP_PORT=3000

# Optional Google sign-in. Self-hosting never requires this - email and
# password always works. Leave unset to hide the Google button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Recurring invoices. The scheduler runs inside the app process by default and
# needs no configuration. These two are only for tuning it:
# - Set a token to also expose POST /api/cron/run for an external scheduler
#   (system cron, a platform cron job). Without it the endpoint stays a 404.
#   This is what serverless deployments (no long-lived process) should use.
# CLERQ_CRON_TOKEN=
# - Set to 1 to turn the in-process ticker off (e.g. when driving the sweep
#   solely through /api/cron/run, or on a read-only replica).
# CLERQ_DISABLE_SCHEDULER=

# Optional AI receipt scanning on the expenses form. Set an OpenRouter API key
# to show a "Scan with AI" button that reads an uploaded receipt (PNG, JPEG, or
# PDF) and pre-fills the expense fields. Leave unset to hide the button
# entirely. Get a key at https://openrouter.ai/keys. PDFs are rasterized to an
# image in the browser first; the image is sent to OpenRouter only when a user
# clicks scan.
# OPENROUTER_API_KEY=
# Optional: override the vision model. Must be an OpenRouter model that accepts
# image input (defaults to qwen/qwen3.7-flash).
# OPENROUTER_VISION_MODEL=qwen/qwen3.7-flash
# Optional: point at an OpenAI-compatible proxy/gateway instead of OpenRouter
# direct (defaults to https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
